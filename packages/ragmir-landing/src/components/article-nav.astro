---
import { ArrowUpRight, ChevronDown } from "@lucide/astro"

interface NavLink {
  href: string
  title: string
  current?: boolean
  /** Opens another site in a new tab, such as Context7. */
  external?: boolean
}

interface Props {
  label: string
  /** The links, in groups under an optional title, such as the documentation's sections. */
  groups: ReadonlyArray<{ title?: string; links: readonly NavLink[] }>
  /**
   * `rail` stays in view beside the text on wide screens; `disclosure` folds under the title on
   * narrow ones, where a rail has no room.
   */
  variant: "rail" | "disclosure"
  /** The links point at this page's sections, so the reading position can light one of them. */
  sections?: boolean
  /** Read after the title of a link that opens a new tab. */
  newTabLabel?: string
  class?: string
}

const { label, groups, variant, sections = false, newTabLabel = "", class: className } = Astro.props
const linkClass =
  "-ml-px flex items-center border-transparent border-l-2 py-1.5 pl-4 text-muted-foreground leading-snug transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring [&[aria-current]]:border-foreground [&[aria-current]]:font-semibold [&[aria-current]]:text-foreground"
---

{variant === "rail" ? (
  <nav
    aria-label={label}
    class:list={[
      "sticky top-28 max-h-[calc(100dvh-8rem)] overflow-y-auto overscroll-contain pb-6",
      className,
    ]}
  >
    <p class="font-black text-foreground text-sm uppercase tracking-tight">{label}</p>
    {groups.map((group) => (
      <div class="mt-4">
        {group.title && <p class="mb-2 font-semibold text-foreground/90 text-xs">{group.title}</p>}
        <ul class="border-border border-l text-sm" role="list">
          {group.links.map((link) => (
            <li>
              <a
                aria-current={link.current ? "page" : undefined}
                class={linkClass}
                data-toc-link={sections ? "" : undefined}
                href={link.href}
                {...(link.external ? { target: "_blank", rel: "noopener" } : {})}
              >
                {link.title}
                {link.external && (
                  <Fragment>
                    <span class="sr-only">{` ${newTabLabel}`}</span>
                    <ArrowUpRight aria-hidden="true" class="arrow-out ml-1.5 size-3.5 shrink-0" />
                  </Fragment>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
) : (
  <details class:list={["smooth-details group rounded-xl bg-card", className]}>
    <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 rounded-xl px-5 font-black text-foreground text-sm uppercase tracking-tight focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring [&::-webkit-details-marker]:hidden">
      {label}
      <ChevronDown
        aria-hidden="true"
        class="size-4 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180 motion-reduce:transition-none"
      />
    </summary>
    <nav aria-label={label} class="px-5 pb-4">
      {groups.map((group, index) => (
        <div class:list={[index > 0 && "mt-4"]}>
          {group.title && <p class="mb-2 font-semibold text-foreground/90 text-xs">{group.title}</p>}
          <ul class="border-border border-l text-sm" role="list">
            {group.links.map((link) => (
              <li>
                <a
                  aria-current={link.current ? "page" : undefined}
                  class:list={[linkClass, "min-h-10"]}
                  data-toc-link={sections ? "" : undefined}
                  href={link.href}
                  {...(link.external ? { target: "_blank", rel: "noopener" } : {})}
                >
                  {link.title}
                  {link.external && (
                    <Fragment>
                      <span class="sr-only">{` ${newTabLabel}`}</span>
                      <ArrowUpRight aria-hidden="true" class="arrow-out ml-1.5 size-3.5 shrink-0" />
                    </Fragment>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </details>
)}
