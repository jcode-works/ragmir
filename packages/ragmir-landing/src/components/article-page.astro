---
import { ArrowRight, ArrowUpRight, ChevronRight } from "@lucide/astro"
import { getLocalizedUrl, languages, languageTag, locales, useTranslations } from "../i18n/utils"
import Layout from "../layouts/layout.astro"
import { NAVBAR_TRANSLATIONS, pickTranslations } from "../lib/island-translations"
import { MAINTAINER } from "../lib/maintainer"
import { GITHUB_URL } from "../lib/project-links"
import AnimatedBackdrop from "./animated-backdrop.astro"
import ArticleCards, { type ArticleCard } from "./article-cards.astro"
import { ArticleCodeCopy } from "./article-code-copy"
import ArticleNav from "./article-nav.astro"
import { LandingNavbar } from "./landing-navbar"
import { RagmirBackground } from "./ragmir-background"
import Footer from "./sections/footer.astro"

interface Crumb {
  name: string
  href: string
}

interface SideNav {
  label: string
  links: ReadonlyArray<{ title: string; href: string; current: boolean }>
}

interface Props {
  title: string
  description: string
  h1: string
  summary: string
  locale: string
  /** Root-relative URL of each locale's version; hreflang lists only these. */
  alternates: Readonly<Record<string, string>>
  /** Site path without locale or slashes, such as `integrations/claude-code`. */
  path: string
  kicker: string
  articleType: "TechArticle" | "Article"
  breadcrumbs: readonly Crumb[]
  datePublished: Date
  dateModified: Date
  headings: ReadonlyArray<{ depth: number; slug: string; text: string }>
  related: readonly ArticleCard[]
  /** The page's Markdown source on GitHub, shown for the guides rendered from `docs/`. */
  sourceHref?: string
  /** Sibling pages listed in a rail beside the text, such as every guide of the documentation. */
  sideNav?: SideNav
  /** A hub's pages, shown as cards across the page before its text. */
  cards?: readonly ArticleCard[]
  /** Root-relative URL of the hub the page belongs to, lit in the navigation bar. */
  navSection?: string
}

const {
  title,
  description,
  h1,
  summary,
  locale,
  alternates,
  path,
  kicker,
  articleType,
  breadcrumbs,
  datePublished,
  dateModified,
  headings,
  related,
  sourceHref,
  sideNav,
  cards = [],
  navSection,
} = Astro.props

const { t, translations } = await useTranslations(locale)
const siteBase = Astro.site ?? new URL("https://ragmir.com")
const homeUrl = getLocalizedUrl("/", locale)
const pageUrl = new URL(alternates[locale] ?? getLocalizedUrl(`/${path}`, locale), siteBase).href
const pageLocales = locales.filter((entry) => alternates[entry] !== undefined)
// Every language stays one click away: a language without this page opens its home page.
const alternateLocales = locales.map((entry) => ({
  locale: entry,
  label: languages[entry],
  href: alternates[entry] ?? getLocalizedUrl("/", entry),
}))
const dateFormat = new Intl.DateTimeFormat(languageTag(locale), {
  dateStyle: "long",
  timeZone: "UTC",
})
const isHub = cards.length > 0
const hasBody = Astro.slots.has("default")
// A hub lists its pages instead: a contents list would point past the cards.
const sections = isHub ? [] : headings.filter((heading) => heading.depth === 2)
const hasContents = sections.length > 1
const contents = sections.map((heading) => ({ href: `#${heading.slug}`, title: heading.text }))
const layoutClass = sideNav
  ? "article-layout-docs"
  : hasContents
    ? "article-layout-guide"
    : "article-layout-single"
const ogImageUrl = new URL("/og/ragmir-og.png", siteBase).href
const libraryUrl = `${homeUrl}#library`
const author = { "@type": "Person", ...MAINTAINER }
const relatedColumns = related.length === 3 ? "md:grid-cols-3" : "md:grid-cols-2"
const lastCrumb = breadcrumbs.length - 1

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: title,
    description,
    inLanguage: languageTag(locale),
    isPartOf: { "@id": "https://ragmir.com/#website" },
    about: { "@id": "https://ragmir.com/#source" },
    publisher: { "@id": "https://ragmir.com/#organization" },
    primaryImageOfPage: { "@type": "ImageObject", url: ogImageUrl, width: 2400, height: 1260 },
  },
  {
    "@context": "https://schema.org",
    "@type": articleType,
    "@id": `${pageUrl}#article`,
    headline: h1,
    description,
    inLanguage: languageTag(locale),
    datePublished: datePublished.toISOString(),
    dateModified: dateModified.toISOString(),
    author,
    publisher: { "@id": "https://ragmir.com/#organization" },
    mainEntityOfPage: { "@id": `${pageUrl}#webpage` },
    about: { "@id": "https://ragmir.com/#source" },
    image: [ogImageUrl],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.name,
      item: new URL(crumb.href, siteBase).href,
    })),
  },
]

const pillClass =
  "group inline-flex h-11 items-center gap-2 rounded-full px-5 font-bold text-sm transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
---

<Layout
  title={title}
  description={description}
  locale={locale}
  ogType="article"
  ogImageAlt={t("seo_image_alt")}
  availableLocales={pageLocales}
  alternatePaths={alternates}
  structuredData={structuredData}
>
  <LandingNavbar
    client:load
    alternateLocales={alternateLocales}
    locale={locale}
    currentPath={Astro.url.pathname}
    currentSection={navSection}
    localizedAgentsUrl={`${homeUrl}#agents`}
    localizedDeployUrl={`${homeUrl}#deploy`}
    localizedFaqUrl={`${homeUrl}#faq`}
    localizedFeaturesUrl={`${homeUrl}#capabilities`}
    localizedHomeUrl={`${homeUrl}#top`}
    localizedLibraryUrl={`${homeUrl}#library`}
    localizedTeamUrl={getLocalizedUrl("/team", locale)}
    localizedUseCasesUrl={`${homeUrl}#use-cases`}
    translations={pickTranslations(translations, NAVBAR_TRANSLATIONS)}
  />

  <div class="relative overflow-hidden">
    <RagmirBackground
      behindContent={false}
      className="inset-x-0 top-0 [mask-image:linear-gradient(to_bottom,black_55%,transparent)]"
      client:visible
      height="300px"
    />
    <main
      class:list={[
        sideNav ? "container-wide" : "container-default",
        "relative z-10 px-5 pt-28 pb-24 md:px-8 md:pt-36",
      ]}
    >
      <nav aria-label={t("article_breadcrumb_label")} class="text-shadow-hero">
        <ol class="flex min-w-0 items-center gap-1.5 font-semibold text-sm sm:gap-2">
          {breadcrumbs.map((crumb, index) => (
            <li
              class:list={[
                "flex items-center gap-1.5 sm:gap-2",
                // On a phone the title right below names the page; the trail keeps it for screen readers.
                index === lastCrumb ? "min-w-0 max-md:sr-only" : "shrink-0",
              ]}
            >
              {index > 0 && (
                <ChevronRight
                  aria-hidden="true"
                  class:list={["size-3.5 shrink-0 text-foreground/45", index === lastCrumb && "max-md:hidden"]}
                />
              )}
              {index < lastCrumb ? (
                <a
                  class="rounded-sm text-foreground/65 underline-offset-4 transition-colors hover:text-foreground hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                  href={crumb.href}
                >
                  {crumb.name}
                </a>
              ) : (
                <span aria-current="page" class="truncate text-foreground/85" title={crumb.name}>
                  {crumb.name}
                </span>
              )}
            </li>
          ))}
        </ol>
      </nav>

      <article class:list={["article-layout mt-8", layoutClass]}>
        <header class="max-w-3xl [grid-area:header]">
          <p class="text-shadow-hero flex items-center gap-3 font-mono text-[10px] text-muted-foreground uppercase tracking-[0.25em]">
            <span aria-hidden="true" class="h-px w-10 bg-foreground/40" />
            <span class="tnum">001</span>
            <span aria-hidden="true" class="opacity-60">·</span>
            <span>{kicker}</span>
          </p>
          <h1 class="display text-shadow-hero mt-6 text-balance text-4xl md:text-5xl">{h1}</h1>
          <p class="text-shadow-hero mt-6 text-base text-foreground/85 leading-relaxed md:text-lg">
            {summary}
          </p>
          <p class="mt-6 flex flex-wrap gap-x-4 gap-y-1 text-muted-foreground text-xs leading-6">
            <span>
              {t("article_by")}{" "}
              <a
                class="font-semibold text-foreground underline-offset-4 hover:underline"
                href={getLocalizedUrl("/team", locale)}
              >
                {MAINTAINER.name}
              </a>
            </span>
            <span>
              {t("article_published")}{" "}
              <time datetime={datePublished.toISOString()}>{dateFormat.format(datePublished)}</time>
            </span>
            {dateModified.getTime() !== datePublished.getTime() && (
              <span>
                {t("article_updated")}{" "}
                <time datetime={dateModified.toISOString()}>{dateFormat.format(dateModified)}</time>
              </span>
            )}
          </p>
        </header>

        {sideNav && (
          <aside class="[grid-area:nav] max-lg:hidden">
            <ArticleNav label={sideNav.label} links={sideNav.links} variant="rail" />
          </aside>
        )}

        {(hasContents || sideNav) && (
          <div
            class:list={[
              "mt-10 flex flex-col gap-3 [grid-area:menus]",
              sideNav ? "xl:hidden" : "lg:hidden",
            ]}
          >
            {sideNav && (
              <ArticleNav class="lg:hidden" label={sideNav.label} links={sideNav.links} variant="disclosure" />
            )}
            {hasContents && (
              <ArticleNav label={t("article_toc")} links={contents} sections variant="disclosure" />
            )}
          </div>
        )}

        {isHub && <ArticleCards cards={cards} class="mt-12 [grid-area:hub] sm:grid-cols-2 lg:grid-cols-3" />}

        {(hasBody || sourceHref) && (
        <div class:list={["min-w-0 [grid-area:body]", isHub ? "mt-16" : "mt-10 lg:mt-12"]}>
          {hasBody && (
            <div id="article-body" class:list={["prose-article", (isHub || !hasContents) && !sideNav && "max-w-2xl"]}>
              <slot />
            </div>
          )}

          {sourceHref && (
            <p class="mt-10">
              <a
                class={`${pillClass} bg-card text-foreground hover:bg-[var(--card-hover)] active:bg-[var(--card-press)]`}
                href={sourceHref}
                rel="noopener"
                target="_blank"
              >
                {t("article_source")}
                <span class="sr-only">{` ${t("new_tab_label")}`}</span>
                <ArrowUpRight aria-hidden="true" class="arrow-out size-4 text-muted-foreground" />
              </a>
            </p>
          )}
        </div>
        )}

        {hasContents && (
          <aside class:list={["[grid-area:toc]", sideNav ? "max-xl:hidden" : "max-lg:hidden"]}>
            <ArticleNav label={t("article_toc")} links={contents} sections variant="rail" />
          </aside>
        )}
      </article>

      {related.length > 0 && (
        <section aria-labelledby="related-title" class="mt-20">
          <p class="flex items-center gap-3 font-mono text-[10px] text-muted-foreground uppercase tracking-[0.25em]">
            <span aria-hidden="true" class="h-px w-10 bg-foreground/40" />
            <span class="tnum">002</span>
            <span aria-hidden="true" class="opacity-60">·</span>
            <span>{t("article_related_label")}</span>
          </p>
          <h2 id="related-title" class="display mt-6 text-balance text-3xl">{t("article_related_title")}</h2>
          <ArticleCards
            cards={related.map((card, index) => ({
              ...card,
              tag: `${String(index + 1).padStart(2, "0")} / ${String(related.length).padStart(2, "0")}`,
            }))}
            class={`mt-8 ${relatedColumns}`}
          />
        </section>
      )}
      <section aria-labelledby="article-cta-title" class="mt-20 rounded-xl bg-card px-6 py-12 text-center md:px-12">
        <p class="font-mono text-[10px] text-muted-foreground uppercase tracking-[0.25em]">
          {t("closing_eyebrow")}
        </p>
        <h2 id="article-cta-title" class="display mx-auto mt-5 max-w-2xl text-balance text-3xl">
          {t("closing_title")}
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-muted-foreground text-sm leading-6 md:text-base">
          {t("closing_text")}
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            class="group inline-flex h-11 items-center gap-2 rounded-full bg-primary px-5 font-bold text-primary-foreground text-sm transition-colors duration-200 hover:bg-[var(--primary-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring active:bg-[var(--primary-press)]"
            href={libraryUrl}
          >
            {t("closing_secondary_cta")}
            <ArrowRight aria-hidden="true" class="arrow-forward size-4" />
          </a>
          <a
            class={`${pillClass} bg-background text-foreground hover:bg-[var(--card-hover)] active:bg-[var(--card-press)]`}
            href={GITHUB_URL}
            rel="noopener noreferrer"
            target="_blank"
          >
            {t("closing_primary_cta")}
            <span class="sr-only">{` ${t("new_tab_label")}`}</span>
            <ArrowUpRight aria-hidden="true" class="arrow-out size-4 text-muted-foreground" />
          </a>
        </div>
      </section>
    </main>
  </div>

  <ArticleCodeCopy
    client:idle
    containerId="article-body"
    copiedMessage={t("command_copied")}
    copyLabel={t("copy_code")}
    failedMessage={t("copy_failed")}
  />

  <!-- The footer sits on the animated dot field, as it does on the home page. -->
  <AnimatedBackdrop>
    <Footer
      alternateLocales={alternateLocales}
      locale={locale}
      localizedHomeUrl={`${homeUrl}#top`}
      translations={translations}
    />
  </AnimatedBackdrop>
</Layout>

<script>
  // The contents list lights the section being read, in the rail and in the folded list. The router
  // swaps pages without running this module again, so each page is wired on `astro:page-load`.
  let stop: (() => void) | undefined

  document.addEventListener("astro:page-load", () => {
    stop?.()
    stop = undefined
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("a[data-toc-link]"))
    if (links.length === 0) return
    const targetOf = (link: HTMLAnchorElement): string => decodeURIComponent(link.hash.slice(1))
    const headings = Array.from(new Set(links.map(targetOf)))
      .map((id) => document.getElementById(id))
      .filter((heading) => heading !== null)
    let frame = 0
    const update = () => {
      frame = 0
      // A section counts as read once its heading passes the upper third of the window.
      const line = window.innerHeight / 3
      let current = ""
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top > line) break
        current = heading.id
      }
      for (const link of links) {
        if (targetOf(link) === current) link.setAttribute("aria-current", "location")
        else link.removeAttribute("aria-current")
      }
    }
    const onScroll = () => {
      if (frame === 0) frame = requestAnimationFrame(update)
    }
    window.addEventListener("scroll", onScroll, { passive: true })
    update()
    stop = () => {
      window.removeEventListener("scroll", onScroll)
      cancelAnimationFrame(frame)
    }
  })
</script>
