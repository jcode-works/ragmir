---
import { ChevronRight } from "@lucide/astro"
import type { Crumb } from "../lib/page-schema"

interface Props {
  crumbs: readonly Crumb[]
  label: string
  class?: string
}

const { crumbs, label, class: className } = Astro.props
const last = crumbs.length - 1
---

<nav aria-label={label} class={className}>
  <ol class="flex min-w-0 items-center gap-1.5 font-semibold text-sm sm:gap-2">
    {crumbs.map((crumb, index) => (
      <li
        class:list={[
          "flex items-center gap-1.5 sm:gap-2",
          // On a phone the title right below names the page; the trail keeps it for screen readers.
          index === last ? "min-w-0 max-md:sr-only" : "shrink-0",
        ]}
      >
        {index > 0 && (
          <ChevronRight
            aria-hidden="true"
            class:list={["size-3.5 shrink-0 text-foreground/45", index === last && "max-md:hidden"]}
          />
        )}
        {index < last ? (
          <a
            class="rounded-sm text-foreground/65 underline-offset-4 transition-colors hover:text-foreground hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            href={crumb.href}
          >
            {crumb.name}
          </a>
        ) : (
          <span aria-current="page" class="truncate text-foreground/85" title={crumb.name}>
            {crumb.name}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
