---
import DeepLink from "../deep-link.astro"
import { ArrowRight, ChevronDown } from "@lucide/astro"
import { FEATURED_FORMATS, SUPPORTED_FORMAT_GROUPS } from "../../content/supported-formats"
import { PROJECT_LINKS } from "../../lib/project-links"
import { CapabilitiesExplorer } from "../capabilities-explorer"
import { SectionHeader } from "../section-header"

interface Props {
  translations: Record<string, string>
  /** The page that covers this section's subject, in the visitor's language when it exists. */
  deepLinkUrl: string
}

const { translations, deepLinkUrl } = Astro.props
const t = (key: string): string => translations[key] ?? key

// One group per step an answer travels (index, search, cite, maintain), then what surrounds it.
// Each group has four items, read from `capabilities_<group>_<n>_name` and `_text`.
const groups = ["index", "search", "cite", "wiki", "connect", "measure", "run", "control"].map(
  (key) => ({
    key,
    title: t(`capabilities_${key}_title`),
    items: [1, 2, 3, 4].map((item) => ({
      name: t(`capabilities_${key}_${item}_name`),
      text: t(`capabilities_${key}_${item}_text`),
    })),
  }),
)
---

<section
  id="capabilities"
  aria-labelledby="capabilities-heading"
  class="container-default relative z-10 px-5 py-16 md:px-8 md:py-40"
>
  <div class="mb-10 md:mb-14">
    <SectionHeader
      num="002"
      label={t("capabilities_eyebrow")}
      title={t("capabilities_title")}
      text={t("capabilities_text")}
      id="capabilities-heading"
    />
  </div>

  <div class="rounded-xl bg-card p-2 md:p-3">
    <CapabilitiesExplorer client:idle groups={groups} label={t("capabilities_eyebrow")}>
      <div class="border-foreground/[0.08] border-t pt-5">
        <div class="flex flex-wrap items-center gap-1.5">
          <h3 class="mr-2 inline-flex items-center gap-2 font-bold text-sm" id="formats-heading">
            {t("formats_title")}
            <span class="tnum rounded-full bg-foreground/[0.08] px-2 py-0.5 font-mono font-medium text-micro text-muted-foreground">
              <span aria-hidden="true">{t("formats_count")}</span>
              <span class="sr-only">{t("formats_count_label")}</span>
            </span>
          </h3>
          <ul aria-labelledby="formats-heading" class="contents" role="list">
            {FEATURED_FORMATS.map((format) => (
              <li class="rounded-full bg-background px-2.5 py-1 font-semibold text-foreground/85 text-xs">
                {format}
              </li>
            ))}
          </ul>
        </div>
        <details class="smooth-details group mt-3">
          <summary class="inline-flex min-h-8 cursor-pointer list-none items-center gap-1.5 rounded-full font-bold text-muted-foreground text-sm transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring [&::-webkit-details-marker]:hidden">
            {t("formats_show_all")}
            <ChevronDown
              aria-hidden="true"
              class="size-4 transition-transform duration-300 group-open:rotate-180 motion-reduce:transition-none"
            />
          </summary>
          <p class="mt-3 max-w-2xl text-muted-foreground text-sm leading-6">{t("formats_text")}</p>
          <dl class="mt-6 grid gap-x-8 gap-y-5 md:grid-cols-2">
            {SUPPORTED_FORMAT_GROUPS.map((group) => (
              <div>
                <dt class="font-semibold text-foreground/70 text-xs">{t(group.labelKey)}</dt>
                <dd class="mt-2 text-foreground/85 text-sm leading-6">{group.formats.join(", ")}</dd>
              </div>
            ))}
          </dl>
          <a
            class="mt-6 inline-flex h-10 w-fit items-center gap-2 rounded-full bg-background px-4 font-bold text-foreground text-sm transition-colors hover:bg-[var(--inset-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring active:bg-[var(--card-press)]"
            href={PROJECT_LINKS.supportedFormats}
          >
            {t("formats_full_list")}
            <ArrowRight aria-hidden="true" class="arrow-forward size-4 text-muted-foreground" />
          </a>
        </details>
      </div>
    </CapabilitiesExplorer>
  </div>

  <div class="mt-10 flex flex-wrap justify-center gap-3">
    <DeepLink href={PROJECT_LINKS.docs} label={t("capabilities_docs_link")} />
    <DeepLink href={deepLinkUrl} label={t("home_link_citations")} />
  </div>
</section>
