---
import { ArrowUpRight } from "@lucide/astro"
import { GithubIcon, NpmIcon, PypiIcon } from "../brand-icons"
import RagmirLogo from "../ragmir-logo.astro"
import { languageTag } from "../../i18n/utils"
import { JCODE_URL } from "../../lib/maintainer"
import {
  FOOTER_SECTIONS,
  GITHUB_URL,
  isExternalLink,
  NPM_URL,
  PROJECT_LINK_LABEL_KEYS,
  PROJECT_LINKS,
  PYPI_URL,
} from "../../lib/project-links"

interface Props {
  translations: Record<string, string>
  localizedHomeUrl: string
  locale: string
  /** Every language, each pointing at this page in it, or at its home page when there is none. */
  alternateLocales: ReadonlyArray<{ locale: string; label: string; href: string }>
}

const { translations, localizedHomeUrl, locale, alternateLocales } = Astro.props
const t = (key: string): string => translations[key] ?? key
const version = import.meta.env.PUBLIC_RAGMIR_VERSION?.trim()
const newTab = t("new_tab_label")
const homePath = localizedHomeUrl.replace(/#.*$/u, "")
// The build year: the site is static, and every release rebuilds it.
const year = new Date().getUTCFullYear()

const sections = FOOTER_SECTIONS.map((section) => ({
  title: t(section.titleKey),
  links: [
    ...(section.anchors ?? []).map((anchor) => ({
      href: `${homePath}#${anchor.hash}`,
      label: t(anchor.labelKey),
      external: false,
    })),
    ...section.links.map((key) => ({
      href: PROJECT_LINKS[key],
      label: t(PROJECT_LINK_LABEL_KEYS[key]),
      external: isExternalLink(PROJECT_LINKS[key]),
    })),
  ],
}))

// A link that leaves the site shows the drawer's leaning arrow and says it opens a new tab.
const linkClass =
  "flex min-h-11 items-center justify-center gap-1.5 rounded-sm py-1 text-sm font-medium leading-5 text-foreground underline-offset-4 transition-colors hover:underline active:text-foreground/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring sm:min-h-8 lg:justify-start"
const iconLinkClass =
  "flex size-10 items-center justify-center rounded-full bg-card text-foreground transition-colors hover:bg-[var(--card-hover)] active:bg-[var(--card-press)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
const marqueeCopy =
  "whitespace-nowrap pr-8 font-black text-5xl text-foreground/90 uppercase italic leading-[1.1] tracking-tighter md:pr-14 md:text-7xl"
---

<footer class="relative z-10 mt-10 overflow-hidden">
  <div class="relative isolate overflow-hidden pt-16 pb-10">
    <nav aria-label={t("footer_nav_label")} class="relative z-10 px-5 md:px-8">
      <div
        class="mx-auto grid max-w-6xl grid-cols-1 gap-y-10 text-center sm:grid-cols-2 sm:gap-x-8 lg:grid-cols-4 lg:text-start"
      >
        {sections.map((section) => (
          <section class="flex flex-col items-center gap-3 lg:items-start">
            <h2 class="font-black text-foreground text-sm uppercase tracking-tight">
              {section.title}
            </h2>
            <ul class="flex w-full flex-col" role="list">
              {section.links.map((link) => (
                <li>
                  <a
                    class={linkClass}
                    href={link.href}
                    {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                  >
                    {link.label}
                    {link.external && (
                      <Fragment>
                        <span class="sr-only">{` ${newTab}`}</span>
                        <ArrowUpRight
                          aria-hidden="true"
                          class="arrow-out size-3.5 shrink-0 text-muted-foreground"
                        />
                      </Fragment>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </nav>

    <div aria-hidden="true" class="relative z-10 my-10 overflow-hidden py-3" data-marquee>
      <div class="flex w-max animate-marquee-text">
        <span class={marqueeCopy}>{t("footer_marquee")}</span>
        <span class={marqueeCopy}>{t("footer_marquee")}</span>
      </div>
    </div>

    <div class="relative z-10 px-5 md:px-8">
      <div
        class="mx-auto flex max-w-6xl flex-col items-center gap-5 text-center sm:flex-row sm:items-center sm:justify-between sm:text-start"
      >
        <div class="flex flex-col items-center gap-3 sm:flex-row sm:items-center">
          <a aria-label="Ragmir" class="flex shrink-0 items-center" href={localizedHomeUrl}>
            <RagmirLogo />
          </a>
          <p class="max-w-xl text-foreground/80 text-xs leading-5">{t("footer_text")}</p>
        </div>

        <div class="flex shrink-0 items-center gap-2" role="group" aria-label={t("footer_social_label")}>
          <a
            class={iconLinkClass}
            href={GITHUB_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${t("hero_github_cta")} ${newTab}`}
          >
            <GithubIcon className="size-4" />
          </a>
          <a
            class={iconLinkClass}
            href={NPM_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${t("hero_npm_cta")} ${newTab}`}
          >
            <NpmIcon className="size-4" />
          </a>
          <a
            class={iconLinkClass}
            href={PYPI_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${t("hero_pypi_cta")} ${newTab}`}
          >
            <PypiIcon className="size-4" />
          </a>
          {version && (
            <a
              href={NPM_URL}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${t("footer_version_label")}: v${version} ${newTab}`}
              class="ml-1 font-semibold text-foreground text-xs underline-offset-4 transition-colors hover:underline active:text-foreground/70"
            >
              v{version}
            </a>
          )}
        </div>
      </div>

      <div
        class="mx-auto mt-8 flex max-w-6xl flex-col-reverse items-center gap-4 sm:flex-row sm:justify-between"
      >
        <p class="text-muted-foreground text-xs">
          © {year}{" "}
          <a
            class="font-semibold text-foreground underline-offset-4 transition-colors hover:underline active:text-foreground/70"
            href={JCODE_URL}
            rel="noopener"
            target="_blank"
          >
            JCode Works<span class="sr-only">{` ${newTab}`}</span>
          </a>
        </p>
        <nav aria-label={t("language_label")}>
          <ul class="flex flex-wrap items-center justify-center gap-1 rounded-full bg-card p-1" role="list">
            {alternateLocales.map((entry) => (
              <li>
                <a
                  aria-current={entry.locale === locale ? "page" : undefined}
                  class="flex min-h-8 items-center rounded-full px-3 font-semibold text-muted-foreground text-xs transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring active:bg-[var(--card-hover)] aria-[current=page]:bg-foreground aria-[current=page]:text-background"
                  href={entry.href}
                  hreflang={languageTag(entry.locale)}
                  lang={languageTag(entry.locale)}
                >
                  {entry.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </div>
</footer>

<script>
  // The marquee loops forever: it pauses whenever it is off screen, and under the pointer or focus
  // in the footer (global.css). The router swaps pages without running this module again, so each
  // page's footer is observed on `astro:page-load`.
  let marquees: IntersectionObserver | undefined

  document.addEventListener("astro:page-load", () => {
    marquees?.disconnect()
    marquees = new IntersectionObserver((entries) => {
      for (const entry of entries) entry.target.toggleAttribute("data-paused", !entry.isIntersecting)
    })
    for (const marquee of document.querySelectorAll("[data-marquee]")) marquees.observe(marquee)
  })
</script>
