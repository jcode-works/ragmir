---
import { ArrowRight, ArrowUpRight } from "@lucide/astro"
import type { IntegrationLogoKey } from "../../content/integration-logos"
import IntegrationMark from "../integration-mark.astro"
import { SectionHeader } from "../section-header"
import { isExternalLink, NPM_URL } from "../../lib/project-links"

interface Props {
  translations: Record<string, string>
}

const { translations } = Astro.props
const t = (key: string): string => translations[key] ?? key

// The guides of `docs/` and the integration pages are pages of this site.
const docsUrl = (file: string, anchor?: string): string =>
  `/docs/${file.replace(/\.md$/u, "")}/${anchor ? `#${anchor}` : ""}`
const integrationUrl = (page: string): string => `/integrations/${page}/`

interface Integration {
  /** Anchor of the card, `#integration-<id>`, which the hero's "Works with" logos link to. */
  id: string
  name: string
  kind: string
  href: string
  logo?: IntegrationLogoKey
  fallback?: "terminal" | "library" | "bot" | "skills"
}

const groups: { title: string; items: Integration[] }[] = [
  {
    title: t("integrations_group_agents"),
    items: [
      { id: "claude-code", name: "Claude Code", kind: t("integrations_kind_plugin"), href: integrationUrl("claude-code"), logo: "claude" },
      { id: "codex", name: "OpenAI Codex", kind: t("integrations_kind_plugin"), href: integrationUrl("codex"), fallback: "terminal" },
      { id: "cursor", name: "Cursor", kind: t("integrations_kind_plugin"), href: integrationUrl("cursor"), logo: "cursor" },
      { id: "gemini-cli", name: "Gemini CLI", kind: t("integrations_kind_extension"), href: integrationUrl("gemini-cli"), logo: "gemini" },
      { id: "qwen-code", name: "Qwen Code", kind: t("integrations_kind_extension"), href: integrationUrl("gemini-cli"), logo: "qwen" },
      {
        id: "more-agents",
        name: "Kimi, OpenCode, Cline",
        kind: t("integrations_kind_setup"),
        href: docsUrl("agent-integration.md", "connect-an-agent-through-mcp"),
        fallback: "bot",
      },
    ],
  },
  {
    title: t("integrations_group_frameworks"),
    items: [
      {
        id: "langchain-js",
        name: "LangChain.js",
        kind: t("integrations_kind_retriever"),
        href: integrationUrl("langchain"),
        logo: "langchain",
      },
      { id: "langchain-python", name: "LangChain", kind: t("integrations_kind_python"), href: integrationUrl("langchain"), logo: "langchain" },
      { id: "llamaindex", name: "LlamaIndex", kind: t("integrations_kind_python"), href: integrationUrl("llamaindex"), fallback: "library" },
      { id: "typescript", name: "TypeScript", kind: t("integrations_kind_library"), href: docsUrl("api-reference.md"), logo: "typescript" },
    ],
  },
  {
    title: t("integrations_group_protocols"),
    items: [
      {
        id: "mcp",
        name: "MCP",
        kind: t("integrations_kind_mcp"),
        href: docsUrl("agent-integration.md", "connect-an-agent-through-mcp"),
        logo: "mcp",
      },
      {
        id: "agent-skills",
        name: "Agent Skills",
        kind: t("integrations_kind_skills"),
        href: docsUrl("agent-integration.md", "agent-skills-for-any-agent"),
        fallback: "skills",
      },
      { id: "python", name: "Python", kind: t("integrations_kind_python_client"), href: docsUrl("python.md"), logo: "python" },
      { id: "npm", name: "npm", kind: t("integrations_kind_cli"), href: NPM_URL, logo: "npm" },
      { id: "docker", name: "Docker", kind: t("integrations_kind_container"), href: docsUrl("docker.md"), logo: "docker" },
      {
        id: "ollama",
        name: "Ollama",
        kind: t("integrations_kind_local_model"),
        href: docsUrl("agent-integration.md", "confidential-chat-local-model-example"),
        logo: "ollama",
      },
    ],
  },
]
---

<section
  id="integrations"
  aria-labelledby="integrations-heading"
  class="container-default relative z-10 px-5 py-16 md:px-8 md:py-40"
>
  <div class="mb-10 md:mb-14">
    <SectionHeader
      num="005"
      label={t("integrations_eyebrow")}
      title={t("integrations_title")}
      text={t("integrations_text")}
      id="integrations-heading"
    />
  </div>

  <div class="grid gap-8 lg:grid-cols-3 lg:gap-6">
    {groups.map((group) => (
      <div>
        <h3 class="mb-3 font-mono text-[10px] text-muted-foreground uppercase tracking-[0.25em]">
          {group.title}
        </h3>
        <ul class="grid grid-cols-2 gap-2 lg:grid-cols-1" role="list">
          {group.items.map((item) => {
            return (
              <li>
                <a
                  class="integration-card group flex h-full items-center gap-3 rounded-xl bg-card px-4 py-3.5 transition-colors hover:bg-[var(--card-hover)] active:bg-[var(--card-press)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                  href={item.href}
                  id={`integration-${item.id}`}
                >
                  <span class="flex size-6 shrink-0 items-center justify-center text-foreground">
                    <IntegrationMark class="size-5" mark={item.logo ?? item.fallback ?? "terminal"} />
                  </span>
                  <span class="min-w-0">
                    <span class="block font-bold text-sm leading-5">{item.name}</span>
                    <span class="block text-muted-foreground text-xs leading-4">{item.kind}</span>
                  </span>
                  {isExternalLink(item.href) ? (
                    <ArrowUpRight
                      aria-hidden="true"
                      class="arrow-out ml-auto size-4 shrink-0 self-start text-muted-foreground"
                    />
                  ) : (
                    <ArrowRight
                      aria-hidden="true"
                      class="arrow-forward ml-auto size-4 shrink-0 self-start text-muted-foreground"
                    />
                  )}
                </a>
              </li>
            )
          })}
        </ul>
      </div>
    ))}
  </div>

  <a
    class="mx-auto mt-10 flex w-fit h-11 items-center gap-2 rounded-full bg-card px-5 text-sm font-bold text-foreground transition-colors hover:bg-[var(--card-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring active:bg-[var(--card-press)]"
    href="/integrations/"
  >
    {t("integrations_all_link")}
    <ArrowRight class="arrow-forward size-4" aria-hidden="true" />
  </a>
</section>
