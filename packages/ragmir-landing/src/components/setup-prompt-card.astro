---
import { SETUP_PROMPTS, type SetupVariant } from "../content/setup-prompts"
import { useTranslations } from "../i18n/utils"
import { PromptBlock } from "./prompt-block"

interface Props {
  variant: SetupVariant
  locale: string
  /** The local or cloud guide in this locale. */
  privacyHref: string
  class?: string
}

/*
 * The short way through a guide: one prompt to paste into an AI agent, set as a code block, then
 * what the agent does with it, step by step, as cards. The page keeps the manual steps after it.
 */
const { variant, locale, privacyHref, class: className } = Astro.props
const { t } = await useTranslations(locale)
const steps = [1, 2, 3, 4].map((step) => ({
  title: t(`setup_${variant}_step${step}_title`),
  text: t(`setup_${variant}_step${step}`),
}))
---

<section aria-labelledby="setup-prompt" class={className}>
  <h2 id="setup-prompt" class="type-section scroll-mt-28">{t("setup_title")}</h2>
  <p class="mt-3 max-w-2xl text-muted-foreground text-sm leading-6">{t(`setup_${variant}_intro`)}</p>
  <PromptBlock
    className="mt-5"
    client:visible
    copiedLabel={t("command_copied")}
    copyLabel={t("copy_prompt")}
    id={`setup-prompt-${variant}`}
    label={t("quickstart_prompt_tab")}
    prompt={SETUP_PROMPTS[variant]}
  />

  <h3 class="mt-8 font-bold text-sm">{t("setup_steps_title")}</h3>
  <ol class="mt-3 grid gap-3 sm:grid-cols-2" role="list">
    {steps.map((step, index) => (
      <li class="rounded-xl bg-card p-5">
        <p class="flex items-baseline gap-2 font-bold text-sm">
          <span aria-hidden="true" class="tnum text-muted-foreground text-xs">{index + 1}</span>
          {step.title}
        </p>
        <p class="mt-1 text-muted-foreground text-small leading-5">{step.text}</p>
      </li>
    ))}
  </ol>

  <p class="mt-5 max-w-2xl text-muted-foreground text-xs leading-5">
    {t("setup_privacy")}{" "}
    <a class="font-semibold text-foreground underline-offset-4 hover:underline" href={privacyHref}>
      {t("setup_privacy_link")}
    </a>
  </p>
</section>
