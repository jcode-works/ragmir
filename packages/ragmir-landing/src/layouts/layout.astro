---
import { ClientRouter } from "astro:transitions"
import "../styles/global.css"
import { defaultLang, getLocalizedUrl, locales, useTranslations } from "../i18n/utils"

interface Props {
  title?: string
  description?: string
  locale?: string
  ogType?: string
  ogImage?: string
  ogImageAlt?: string
  twitterCard?: string
  author?: string
  /** Comma-separated keywords in the page's language. */
  keywords?: string
  robots?: string
  structuredData?: Record<string, unknown> | Record<string, unknown>[]
  canonicalOverride?: string
  availableLocales?: readonly string[] | string[]
  /** Root-relative URL of each locale's version, for a page whose path differs between locales. */
  alternatePaths?: Readonly<Record<string, string>>
  /** Id of the element the skip link jumps to, past the navigation bar. */
  skipTarget?: string
}

// Full snippets, which also bound what AI Overviews and AI Mode may quote, and large image and video
// previews. Without these rules Google picks the snippet length and keeps previews at default size.
const INDEXABLE_ROBOTS = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"

const {
  title = "Ragmir",
  description = "Open-source agentic RAG for developers: local project retrieval, exact citations, and your choice of model.",
  locale = "en",
  ogType = "website",
  ogImage = "/og/ragmir-og.png",
  ogImageAlt = "Ragmir: agentic RAG on your infrastructure with exact citations",
  twitterCard = "summary_large_image",
  author = "JCode Works",
  keywords,
  robots: robotsProp = INDEXABLE_ROBOTS,
  structuredData,
  canonicalOverride,
  availableLocales = locales,
  alternatePaths,
  skipTarget = "main-content",
} = Astro.props
const { t } = await useTranslations(locale)

const siteBase = Astro.site ?? new URL("https://ragmir.com")
const canonicalURL = canonicalOverride
  ? new URL(canonicalOverride, siteBase)
  : new URL(Astro.url.pathname, siteBase)
const ogImageUrl = new URL(ogImage, siteBase)
const isProduction = siteBase.hostname === "ragmir.com"
const robots = isProduction ? robotsProp : "noindex, nofollow, noarchive, nosnippet, noimageindex"
// An error page answers any path, so it names no canonical URL of its own.
const isIndexable = !/\bnoindex\b/iu.test(robotsProp)
const localesForAlternates = Array.from(new Set(availableLocales)).filter((entry) =>
  (locales as readonly string[]).includes(entry),
)
// hreflang names alternates, so a page in one language lists none (like its sitemap entry).
const hasAlternates = localesForAlternates.length > 1
const hreflangLocaleMap: Record<string, string> = {
  en: "en",
  fr: "fr",
  es: "es",
  zh: "zh-Hans",
}
const ogLocaleMap: Record<string, string> = {
  en: "en_US",
  fr: "fr_FR",
  es: "es_ES",
  zh: "zh_CN",
}
const htmlLang = hreflangLocaleMap[locale] ?? locale
const currentOgLocale = ogLocaleMap[locale] ?? "en_US"
const alternateOgLocales = localesForAlternates
  .filter((entry) => entry !== locale)
  .map((entry) => ogLocaleMap[entry] ?? "en_US")

// An English page that exists in other languages sends a reader whose browser prefers one of them
// to that version; see the inline script in the head. A translated page never redirects.
const localeRedirects: Record<string, string> =
  locale === defaultLang && hasAlternates
    ? Object.fromEntries(
        localesForAlternates
          .filter((entry) => entry !== defaultLang)
          .map((entry) => [entry, alternatePath(entry)]),
      )
    : {}
const redirectsByLanguage = Object.keys(localeRedirects).length > 0

function getImageType(imageUrl: string): string {
  const pathname = new URL(imageUrl, siteBase).pathname.toLowerCase()
  if (pathname.endsWith(".svg")) return "image/svg+xml"
  if (pathname.endsWith(".webp")) return "image/webp"
  if (pathname.endsWith(".jpg") || pathname.endsWith(".jpeg")) return "image/jpeg"
  if (pathname.endsWith(".gif")) return "image/gif"
  return "image/png"
}

function alternatePath(targetLocale: string): string {
  const explicitPath = alternatePaths?.[targetLocale]
  if (explicitPath) return explicitPath
  const currentPath = Astro.url.pathname
  const prefixedLocale = locales.find(
    (entry) =>
      entry !== defaultLang && (currentPath === `/${entry}` || currentPath.startsWith(`/${entry}/`)),
  )
  const basePath = (prefixedLocale ? currentPath.slice(prefixedLocale.length + 1) : currentPath) || "/"
  return getLocalizedUrl(basePath, targetLocale)
}

function alternateHref(targetLocale: string): string {
  return new URL(alternatePath(targetLocale), siteBase).href
}
---

<!doctype html>
<html lang={htmlLang} dir="ltr" class="dark">
  <head>
    <meta charset="UTF-8" />
    {
      redirectsByLanguage && (
        <script is:inline data-astro-rerun define:vars={{ localeRedirects }}>
          // Before anything paints: open this page in the reader's language when it exists. A
          // language picked in the menu wins over the browser's; Chinese of any script gets the
          // Simplified Chinese pages, and any other language stays on English.
          ;(() => {
            let chosen = null
            try {
              chosen = localStorage.getItem("ragmir-locale")
            } catch {}
            const preferences = navigator.languages?.length ? navigator.languages : [navigator.language]
            const preferred =
              chosen ??
              preferences
                .map((tag) => String(tag).toLowerCase().split("-")[0])
                .find((language) => ["en", "fr", "es", "zh"].includes(language))
            const target = preferred && preferred !== "en" ? localeRedirects[preferred] : undefined
            if (target) location.replace(target + location.search + location.hash)
          })()
        </script>
      )
    }
    <script is:inline>
      ;(() => {
        function safeStorageGet(key) {
          try {
            return localStorage.getItem(key)
          } catch {
            return null
          }
        }
        const theme = safeStorageGet("theme")
        const isDark = theme !== "light"
        document.documentElement.classList.toggle("dark", isDark)
        let colorSchemeMeta = document.querySelector('meta[name="color-scheme"]')
        if (!(colorSchemeMeta instanceof HTMLMetaElement)) {
          colorSchemeMeta = document.createElement("meta")
          colorSchemeMeta.name = "color-scheme"
          document.head.appendChild(colorSchemeMeta)
        }
        colorSchemeMeta.content = isDark ? "dark" : "light"
      })()
    </script>
    <style>
      :root {
        --background: #000000;
      }
      html,
      body {
        background-color: var(--background);
      }
    </style>

    <meta name="generator" content={Astro.generator} />
    <meta name="viewport" content="viewport-fit=cover, width=device-width, initial-scale=1.0" />
    <meta name="application-name" content="Ragmir" />
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content={author} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#000000" />
    {isIndexable && <link rel="canonical" href={canonicalURL.href} />}
    {isProduction && <link rel="sitemap" href="/sitemap-index.xml" />}
    <link rel="alternate" href="/llms.txt" type="text/plain" title="LLM instructions" />
    <link rel="alternate" href="/ai.txt" type="text/plain" title="AI instructions" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/inter-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-900-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {isIndexable && <meta property="og:url" content={canonicalURL.href} />}
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:type" content={getImageType(ogImageUrl.href)} />
    <meta property="og:locale" content={currentOgLocale} />
    <meta property="og:site_name" content="Ragmir" />
    {alternateOgLocales.map((entry) => <meta property="og:locale:alternate" content={entry} />)}

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {
      hasAlternates &&
        localesForAlternates.map((entry) => (
          <link rel="alternate" hreflang={hreflangLocaleMap[entry]} href={alternateHref(entry)} />
        ))
    }
    {hasAlternates && <link rel="alternate" hreflang="x-default" href={alternateHref("en")} />}

    {
      structuredData &&
        (Array.isArray(structuredData) ? (
          structuredData.map((data) => (
            <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />
          ))
        ) : (
          <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
        ))
    }

    <title>{title}</title>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="relative min-h-dvh">
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-foreground focus:px-4 focus:py-2 focus:font-bold focus:text-background focus:text-sm"
      href={`#${skipTarget}`}
    >
      {t("skip_to_content")}
    </a>
    <slot />
  </body>
</html>
