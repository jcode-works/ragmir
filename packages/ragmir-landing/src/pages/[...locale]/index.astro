---
import { getCollection } from "astro:content"
import AnimatedBackdrop from "../../components/animated-backdrop.astro"
import { CommandCopyToast } from "../../components/command-copy-toast"
import { FloatingCta } from "../../components/floating-cta"
import { LibrarySection } from "../../components/library-section"
import { LandingNavbar } from "../../components/landing-navbar"
import Agents from "../../components/sections/agents.astro"
import Capabilities from "../../components/sections/capabilities.astro"
import ClosingCta from "../../components/sections/closing-cta.astro"
import Comparison from "../../components/sections/comparison.astro"
import Deploy from "../../components/sections/deploy.astro"
import Faq from "../../components/sections/faq.astro"
import Footer from "../../components/sections/footer.astro"
import Hero from "../../components/sections/hero.astro"
import Integrations from "../../components/sections/integrations.astro"
import Privacy from "../../components/sections/privacy.astro"
import UseCases from "../../components/sections/use-cases.astro"
import {
  defaultLang,
  getLocalizedUrl,
  languages,
  languageTag,
  locales,
  useTranslations,
} from "../../i18n/utils"
import Layout from "../../layouts/layout.astro"
import { findPage, pageHref, pageLocation } from "../../lib/content-pages"
import {
  LIBRARY_TRANSLATIONS,
  NAVBAR_TRANSLATIONS,
  pickTranslations,
} from "../../lib/island-translations"
import { JCODE_URL, MAINTAINER } from "../../lib/maintainer"
import { PROJECT_LINKS } from "../../lib/project-links"

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === defaultLang ? undefined : locale },
  }))
}

const locale = (Astro.params.locale as string | undefined) ?? defaultLang
const { t, translations } = await useTranslations(locale)
const alternateLocales = locales.map((entry) => ({
  locale: entry,
  label: languages[entry],
  href: getLocalizedUrl("/", entry),
}))
const siteUrl = new URL("/", Astro.site ?? "https://ragmir.com").href
const pageUrl = new URL(getLocalizedUrl("/", locale), Astro.site ?? "https://ragmir.com").href
const publicVersion = import.meta.env.PUBLIC_RAGMIR_VERSION?.trim()
const ogImageUrl = new URL("/og/ragmir-og.png", Astro.site ?? "https://ragmir.com").href
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://ragmir.com/#organization",
    // The same entity as the Organization of jcode.works: its name, URL, logo, and profiles.
    name: "jCode",
    alternateName: "JCode Works",
    legalName: "JCODE",
    url: JCODE_URL,
    logo: {
      "@type": "ImageObject",
      url: `${JCODE_URL}/assets/logo-mark.png`,
      width: 600,
      height: 600,
    },
    founder: { "@type": "Person", ...MAINTAINER },
    knowsAbout: [
      "local-first retrieval",
      "agentic RAG workflows",
      "cited document search",
      "Model Context Protocol",
      "AI agent tooling",
      "Node.js RAG library",
      "self-hosted RAG deployment",
      "sovereign RAG",
      "RAG evaluation",
      "retrieval for coding agents",
    ],
    sameAs: [
      "https://github.com/jcode-works",
      "https://www.linkedin.com/in/jean-baptiste-thery",
      "https://www.malt.fr/profile/jeanbaptistethery",
      "https://www.npmjs.com/package/@jcode.labs/ragmir",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://ragmir.com/#website",
    url: siteUrl,
    name: "Ragmir",
    // The shared entities keep their ids on every page and speak the page's language.
    description: t("seo_home_description"),
    inLanguage: locales.map(languageTag),
    publisher: { "@id": "https://ragmir.com/#organization" },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    "@id": "https://ragmir.com/#source",
    name: "Ragmir",
    description: t("seo_source_description"),
    abstract: t("faq_what_answer"),
    url: siteUrl,
    inLanguage: locales.map(languageTag),
    codeRepository: PROJECT_LINKS.github,
    codeSampleType: "full solution",
    // Product names only, so the value reads the same in every language.
    runtimePlatform: [
      "Node.js 22.12+",
      "Linux x64/ARM64 (glibc, musl)",
      "macOS",
      "Windows",
      "Docker (amd64, arm64)",
    ],
    programmingLanguage: ["TypeScript", "Python"],
    audience: {
      "@type": "Audience",
      audienceType: t("seo_source_audience"),
    },
    keywords: [
      "agentic RAG",
      "local RAG",
      "self-hosted RAG",
      "coding agents",
      "cited retrieval",
      "MCP",
      "MCP server",
      "Claude Code plugin",
      "Codex plugin",
      "Cursor plugin",
      "Gemini CLI extension",
      "Qwen Code extension",
      "LangChain.js retriever",
      "LangGraph retriever",
      "LlamaIndex retriever",
      "Python package on PyPI",
      "sovereign RAG",
      "RAG evaluation",
      "RAG without a vector database",
      "CPU-only retrieval",
      "multi-model RAG",
      "data residency",
      "RAG for document corpora",
      "Claude Code document search",
      "Codex document search",
      "LLM wiki",
      "Markdown knowledge base",
      "TypeScript",
      "AGPL open source",
      "Ollama local model",
      "personal document search",
      "YouTube script research",
      "job search with your CV",
      "administrative paperwork",
    ],
    license: PROJECT_LINKS.license,
    usageInfo: PROJECT_LINKS.commercialLicense,
    isAccessibleForFree: true,
    ...(publicVersion ? { version: publicVersion } : {}),
    isPartOf: {
      "@id": "https://ragmir.com/#website",
    },
    sameAs: [
      PROJECT_LINKS.github,
      PROJECT_LINKS.npm,
      PROJECT_LINKS.pypi,
      PROJECT_LINKS.agentSkills,
      PROJECT_LINKS.context7,
      "https://glama.ai/mcp/servers/jcode-works/ragmir",
      "https://mcpmarket.com/server/ragmir",
    ],
    publisher: {
      "@id": "https://ragmir.com/#organization",
    },
    author: {
      "@id": "https://ragmir.com/#organization",
    },
    maintainer: {
      "@id": "https://ragmir.com/#organization",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: t("seo_home_title"),
    description: t("seo_home_description"),
    inLanguage: languageTag(locale),
    isPartOf: { "@id": "https://ragmir.com/#website" },
    about: { "@id": "https://ragmir.com/#source" },
    publisher: { "@id": "https://ragmir.com/#organization" },
    primaryImageOfPage: {
      "@type": "ImageObject",
      url: ogImageUrl,
      width: 2400,
      height: 1260,
    },
  },
]
const localizedHomeUrl = `${getLocalizedUrl("/", locale)}#top`
const localizedLibraryUrl = `${getLocalizedUrl("/", locale)}#library`
const localizedFeaturesUrl = `${getLocalizedUrl("/", locale)}#capabilities`
const localizedUseCasesUrl = `${getLocalizedUrl("/", locale)}#use-cases`
const localizedAgentsUrl = `${getLocalizedUrl("/", locale)}#agents`
const localizedIntegrationsUrl = `${getLocalizedUrl("/", locale)}#integrations`
const localizedDeployUrl = `${getLocalizedUrl("/", locale)}#deploy`
const localizedFaqUrl = `${getLocalizedUrl("/", locale)}#faq`
const localizedTeamUrl = getLocalizedUrl("/team", locale)
// Each section links to the page that covers its subject, in this locale when it is translated.
const contentPages = await getCollection("pages")
const deepLinkUrl = (path: string): string => {
  const page = findPage(path, locale, contentPages)
  if (!page) throw new Error(`The home page links to a missing page: ${path}`)
  const location = pageLocation(page)
  return pageHref(location.path, location.locale)
}
---

<Layout
  title={t("seo_home_title")}
  description={t("seo_home_description")}
  author={t("seo_author")}
  keywords={t("seo_home_keywords")}
  ogImageAlt={t("seo_image_alt")}
  locale={locale}
  availableLocales={locales}
  structuredData={structuredData}
>
  <main class="relative min-h-screen overflow-hidden bg-background text-foreground">
    <LandingNavbar
      client:load
      alternateLocales={alternateLocales}
      locale={locale}
      currentPath={Astro.url.pathname}
      localizedAgentsUrl={localizedAgentsUrl}
      localizedDeployUrl={localizedDeployUrl}
      localizedFaqUrl={localizedFaqUrl}
      localizedFeaturesUrl={localizedFeaturesUrl}
      localizedHomeUrl={localizedHomeUrl}
      localizedLibraryUrl={localizedLibraryUrl}
      localizedTeamUrl={localizedTeamUrl}
      localizedUseCasesUrl={localizedUseCasesUrl}
      translations={pickTranslations(translations, NAVBAR_TRANSLATIONS)}
    />

    <Hero
      translations={translations}
      locale={locale}
      localizedLibraryUrl={localizedLibraryUrl}
      localizedUseCasesUrl={localizedUseCasesUrl}
    />

    <UseCases translations={translations} deepLinkUrl={deepLinkUrl("use-cases/forward-deployed-engineers")} />

    <AnimatedBackdrop>
      <Capabilities translations={translations} deepLinkUrl={deepLinkUrl("rag-citations")} />
    </AnimatedBackdrop>

    <Comparison translations={translations} deepLinkUrl={deepLinkUrl("benchmarks")} />

    <AnimatedBackdrop>
      <LibrarySection
        client:idle
        translations={pickTranslations(translations, LIBRARY_TRANSLATIONS)}
      />
    </AnimatedBackdrop>

    <Integrations translations={translations} />

    <AnimatedBackdrop>
      <Agents
        translations={translations}
        localizedIntegrationsUrl={localizedIntegrationsUrl}
        deepLinkUrl={deepLinkUrl("local-rag")}
      />
    </AnimatedBackdrop>

    <Deploy translations={translations} deepLinkUrl={deepLinkUrl("self-hosted-rag")} />

    <AnimatedBackdrop>
      <Privacy translations={translations} deepLinkUrl={deepLinkUrl("air-gapped-rag")} />
    </AnimatedBackdrop>

    <Faq translations={translations} deepLinkUrl={deepLinkUrl("agentic-rag")} />

    <AnimatedBackdrop>
      <ClosingCta translations={translations} localizedLibraryUrl={localizedLibraryUrl} />
      <Footer localizedHomeUrl={localizedHomeUrl} translations={translations} />
    </AnimatedBackdrop>

    <CommandCopyToast
      client:idle
      copiedMessage={t("command_copied")}
      failedMessage={t("copy_failed")}
    />

    <FloatingCta client:idle href={localizedLibraryUrl} label={t("hero_primary_cta")} />
  </main>
</Layout>
