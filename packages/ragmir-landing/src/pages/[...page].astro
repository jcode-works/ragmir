---
import { getCollection, render } from "astro:content"
import type { ArticleCard } from "../components/article-cards.astro"
import ArticlePage from "../components/article-page.astro"
import type { IntegrationMarkName } from "../content/integration-logos"
import { getLocalizedUrl, useTranslations } from "../i18n/utils"
import {
  type ContentPage,
  findPage,
  HUBS,
  hubOf,
  pageHref,
  pageAlternates,
  pageLocation,
  sectionPages,
} from "../lib/content-pages"
import { DOC_PAGES, docTitle } from "../lib/docs-pages"

export async function getStaticPaths() {
  const entries = await getCollection("pages")
  return entries.map((entry) => {
    const { locale, path } = pageLocation(entry)
    return {
      params: { page: locale === "en" ? path : `${locale}/${path}` },
      props: { entry },
    }
  })
}

interface Props {
  entry: ContentPage
}

const { entry } = Astro.props
const all = await getCollection("pages")
const { locale, path } = pageLocation(entry)
const { t } = await useTranslations(locale)
const { Content, headings } = await render(entry)
const { data } = entry

// A hub page lists the pages of its sections as groups of cards before its own text.
const hub = data.section === "hub" ? HUBS[path] : undefined
const hubPages = hub ? sectionPages(hub.sections, locale, all) : []
const parentHub = hubOf(data.section)
const parent = parentHub ? findPage(parentHub, locale, all) : undefined
const parentHref = parentHub && parent ? pageHref(parentHub, pageLocation(parent).locale) : undefined

const breadcrumbs = [
  { name: "Ragmir", href: getLocalizedUrl("/", locale) },
  ...(parentHub && parentHref
    ? [{ name: t(HUBS[parentHub]?.labelKey ?? "nav_guides"), href: parentHref }]
    : []),
  { name: data.h1, href: pageHref(path, locale) },
]

// A card shows the page's search description: one or two sentences, sized for a card, and the
// tool's mark on an integration page.
const toLink = (page: ContentPage): ArticleCard => {
  const location = pageLocation(page)
  return {
    title: page.data.h1,
    href: pageHref(location.path, location.locale),
    summary: page.data.description,
    ...(page.data.logo ? { mark: page.data.logo } : {}),
  }
}

// A target names a site path, or `docs/<guide>` for a guide rendered from the repository's docs.
const docs = await getCollection("docs")
const resolve = (target: string, mark?: IntegrationMarkName): ArticleCard[] => {
  if (target.startsWith("docs/")) {
    const id = target.slice("docs/".length)
    const doc = docs.find((candidate) => candidate.id === id)
    const meta = DOC_PAGES[id]
    return doc && meta
      ? [{ title: docTitle(doc), href: `/${target}/`, summary: meta.summary, ...(mark ? { mark } : {}) }]
      : []
  }
  const page = findPage(target, locale, all)
  return page ? [{ ...toLink(page), ...(mark ? { mark } : {}) }] : []
}

const cardGroups = (hub?.groups ?? []).map((group) => ({
  title: t(group.labelKey),
  cards: [
    ...hubPages
      .filter(
        (page) =>
          (group.sections?.includes(page.data.section) ?? false) ||
          (group.group !== undefined && page.data.group === group.group),
      )
      .map(toLink),
    ...(group.extra ?? []).flatMap((extra) => resolve(extra.target, extra.mark)),
  ],
}))
const hubHrefs = new Set(cardGroups.flatMap((group) => group.cards.map((card) => card.href)))

// A hub's cards already show its own pages.
const related = data.related
  .flatMap((target) => resolve(target))
  .filter((link) => !hubHrefs.has(link.href))
---

<ArticlePage
  title={data.title}
  description={data.description}
  h1={data.h1}
  summary={data.summary}
  locale={locale}
  alternates={pageAlternates(entry, all)}
  path={path}
  mark={data.logo}
  setup={data.setup}
  notes={data.notes}
  highlights={data.highlights}
  articleType={data.section === "case-study" ? "Article" : "TechArticle"}
  breadcrumbs={breadcrumbs}
  datePublished={data.datePublished}
  dateModified={data.dateModified}
  headings={headings}
  related={related}
  cardGroups={cardGroups}
  navSection={hub ? pageHref(path, locale) : parentHref}
>
  <Content />
</ArticlePage>
