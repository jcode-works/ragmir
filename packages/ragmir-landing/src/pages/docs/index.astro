---
import path from "node:path"
import { getCollection } from "astro:content"
import ArticlePage from "../../components/article-page.astro"
import { DOC_ORDER, DOC_PAGES } from "../../lib/docs-pages"
import { gitDates } from "../../lib/git-dates"

const docs = await getCollection("docs")
const guides = DOC_ORDER.flatMap((id) => {
  const doc = docs.find((candidate) => candidate.id === id)
  const meta = DOC_PAGES[id]
  return doc && meta
    ? [
        {
          id,
          title: doc.body?.match(/^# (.+)$/mu)?.[1]?.trim() ?? id,
          summary: meta.summary,
          dates: doc.filePath ? gitDates(path.resolve(doc.filePath)) : null,
        },
      ]
    : []
})
const published = guides.flatMap((guide) => (guide.dates ? [guide.dates.published] : []))
const modified = guides.flatMap((guide) => (guide.dates ? [guide.dates.modified] : []))
const earliest = new Date(Math.min(...published.map((date) => date.getTime())))
const latest = new Date(Math.max(...modified.map((date) => date.getTime())))
---

<ArticlePage
  title="Ragmir documentation: guides and references | Ragmir docs"
  description="Every Ragmir guide in one place: quick start, agents and MCP, the rgr CLI and TypeScript API, Python, configuration, formats, servers, Docker, and troubleshooting."
  h1="Ragmir documentation"
  summary="The guides that ship with Ragmir, rendered from the repository's docs folder so they always match the current release."
  locale="en"
  pageLocales={["en"]}
  path="docs"
  kicker="Docs"
  articleType="TechArticle"
  breadcrumbs={[
    { name: "Ragmir", href: "/" },
    { name: "Docs", href: "/docs/" },
  ]}
  datePublished={published.length > 0 ? earliest : new Date()}
  dateModified={modified.length > 0 ? latest : new Date()}
  headings={[]}
  related={[]}
>
  <ol class="not-prose grid gap-3 md:grid-cols-2">
    {guides.map((guide, index) => (
      <li>
        <a
          class="flex h-full flex-col rounded-xl bg-card p-6 transition-colors hover:bg-[var(--card-hover)] active:bg-[var(--card-press)]"
          href={`/docs/${guide.id}/`}
        >
          <span class="flex items-center gap-2 font-mono text-[10px] text-muted-foreground uppercase tracking-[0.2em]">
            <span aria-hidden="true" class="size-1.5 rounded-full bg-foreground/50" />
            <span class="tnum">{String(index + 1).padStart(2, "0")} / {String(guides.length).padStart(2, "0")}</span>
          </span>
          <span class="mt-4 font-black text-lg leading-snug">{guide.title}</span>
          <span class="mt-2 text-muted-foreground text-sm leading-6">{guide.summary}</span>
        </a>
      </li>
    ))}
  </ol>
</ArticlePage>
